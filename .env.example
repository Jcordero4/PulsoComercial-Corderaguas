# Supabase > botón "Connect" > pestaña ORM > Prisma.
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base. Si tiene caracteres especiales
# (# @ / : %) codifícalos: # -> %23, @ -> %40, / -> %2F, : -> %3A, % -> %25.

# Pooler de transacciones (puerto 6543): lo usa la aplicación.
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Pooler de sesión (puerto 5432): lo usan las migraciones y las pruebas de integración.
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Generar con: npx auth secret
AUTH_SECRET=""

# Confiar en el host de la petición. Vercel lo activa solo; en cualquier otro alojamiento
# (o al probar "npm start" en local) hay que ponerlo en true, o el login falla en producción.
# AUTH_TRUST_HOST="true"

# Secreto de la tarea programada diaria de Vercel (mínimo 16 caracteres, aleatorio).
# Solo hace falta en Vercel; localmente no se usa. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# Contraseña inicial de los usuarios de ejemplo (solo para el seed, mínimo 10 caracteres).
# Usa una aleatoria y larga: la base está en internet.
SEED_PASSWORD=""
